# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in the values.
# NEVER commit the real .env file — it contains secrets.
# ─────────────────────────────────────────────────────────────

# Database (local: run `npm run db:local` first)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/charisma

# Long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me
PREVIEW_SECRET=change-me-too

# Public address of the website (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "production" ONLY on the live site. Anything else = noindex (staging/preview/local).
NEXT_PUBLIC_SITE_ENV=development

# Google Analytics 4 (leave empty to disable tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email notifications. Leave everything empty in development:
# emails are then printed in the terminal instead of being sent.
# Option A, SendGrid (recommended): create an API key with "Mail Send" permission.
#   EMAIL_FROM_ADDRESS must be a verified sender in SendGrid, or on a domain authenticated in SendGrid (DNS records).
SENDGRID_API_KEY=
# Option B, any other SMTP server (used only when SENDGRID_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=hello@thecharismacode.co
EMAIL_FROM_NAME=The Charisma Code Website

# Cloudflare Turnstile spam check on the forms (optional; both keys are needed to switch it on).
# Create a widget at dash.cloudflare.com → Turnstile, add the website domain(s), copy both keys.
# Local testing: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (S3-compatible) media storage. Leave empty to store files on disk (development only).
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
