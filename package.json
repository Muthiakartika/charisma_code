{
  "name": "charisma-code",
  "version": "0.1.0",
  "private": true,
  "description": "The Charisma Code website — Next.js + Payload CMS",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "ci": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && npm run import:posts && npm run import:handoff:deploy && npm run build",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-database.mjs",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "migrate:wordpress": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/migrate-wordpress.ts",
    "import:posts": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/import-missing-posts.ts",
    "import:handoff": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/handoff/run.ts",
    "import:handoff:deploy": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/handoff/deploy.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:permissions": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/test-permissions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@phosphor-icons/react": "^2.1.10",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "overrides": {
    "undici": "7.30.0"
  }
}
